# Copy this file to .env.local and fill it in. Never commit real keys.

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the webhook page in Stripe.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Live charges stay off until this is true. Leave it unset until the attorney signs off.
# ALLOW_LIVE_PAYMENTS=true

# Password for /admin/bookings. The page returns 404 until this is set.
ADMIN_PASSWORD=choose_a_long_password

# Confirmation and payment emails, sent through https://resend.com.
RESEND_API_KEY=re_replace_me
EMAIL_FROM="War and Peas <hello@your-domain.com>"
# Where new booking and payment problem alerts go.
OWNER_EMAIL=you@your-domain.com

# Protects /api/cron/payments. Call it hourly with the header: Authorization: Bearer <this value>
CRON_SECRET=choose_a_long_random_value

# Production only. Leave blank locally to use the embedded database in .data/.
# DATABASE_URL=postgres://user:password@host:5432/war_and_peas
# SITE_URL=https://your-domain.com
